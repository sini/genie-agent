{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "package sent to the Opus expert",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "thread_id",
    "cleaned_question",
    "draft",
    "eval_transcript",
    "gaps"
  ],
  "properties": {
    "thread_id": {
      "type": "string",
      "minLength": 1
    },
    "cleaned_question": {
      "type": "string",
      "minLength": 1
    },
    "draft": {
      "$ref": "draft.json"
    },
    "eval_transcript": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "request",
          "result"
        ],
        "properties": {
          "request": {
            "$ref": "eval-request.json"
          },
          "result": {
            "$ref": "eval-result.json"
          }
        }
      }
    },
    "gaps": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "recall_transcript": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "git_transcript": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "request",
          "output",
          "screened"
        ],
        "properties": {
          "request": {
            "$ref": "git-request.json"
          },
          "output": {
            "type": "string"
          },
          "screened": {
            "type": "boolean"
          }
        }
      }
    },
    "gh_transcript": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "request",
          "output",
          "screened"
        ],
        "properties": {
          "request": {
            "oneOf": [
              {
                "$ref": "gh-read.json"
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind",
                  "id"
                ],
                "properties": {
                  "kind": {
                    "const": "gist_read"
                  },
                  "id": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{1,64}$"
                  }
                }
              }
            ]
          },
          "output": {
            "type": "string"
          },
          "screened": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
