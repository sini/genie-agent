{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "guard-in verdict on one inbound message",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "verdict",
    "reason",
    "cleaned_text"
  ],
  "properties": {
    "verdict": {
      "enum": [
        "allow",
        "rewrite",
        "reject"
      ]
    },
    "class": {
      "enum": [
        "directs_model",
        "seeks_holdings",
        "coerces_tool",
        "exfil_channel",
        "hidden_instruction",
        "guard_error"
      ]
    },
    "reason": {
      "type": "string"
    },
    "cleaned_text": {
      "type": "string"
    }
  },
  "if": {
    "properties": {
      "verdict": {
        "const": "reject"
      }
    }
  },
  "then": {
    "required": [
      "class"
    ]
  }
}
