{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "guard-in verdict on one inbound message",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "verdict",
    "reason",
    "cleaned_text"
  ],
  "properties": {
    "verdict": {
      "enum": [
        "allow",
        "rewrite",
        "reject"
      ]
    },
    "reason": {
      "type": "string"
    },
    "cleaned_text": {
      "type": "string"
    }
  }
}
