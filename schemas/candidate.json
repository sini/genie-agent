{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "distiller support memory candidate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "document_id",
    "title",
    "problem",
    "solution",
    "diagnostic_steps",
    "tags"
  ],
  "properties": {
    "document_id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "title": {
      "type": "string",
      "minLength": 5
    },
    "problem": {
      "type": "string",
      "minLength": 5
    },
    "solution": {
      "type": "string",
      "minLength": 5
    },
    "diagnostic_steps": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
