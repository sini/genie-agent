{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "tier-1 draft answer",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "answer",
    "confidence",
    "gaps",
    "escalate_forced"
  ],
  "properties": {
    "answer": {
      "type": "string"
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "gaps": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "escalate_forced": {
      "type": "boolean"
    }
  }
}
