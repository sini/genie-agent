{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "typed action proposal for the broker",
  "description": "A gist needs no repository; a PR needs the repository and the branch it opens from, plus either files or worktreeSubdir.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "title",
    "body"
  ],
  "properties": {
    "kind": {
      "enum": [
        "gist",
        "pr"
      ]
    },
    "repo": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_][A-Za-z0-9_-]*(?:\\.[A-Za-z0-9_-]+)*\\/[A-Za-z0-9_][A-Za-z0-9_-]*(?:\\.[A-Za-z0-9_-]+)*$"
    },
    "branch": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_][A-Za-z0-9_-]*(?:\\.[A-Za-z0-9_-]+)*(?:\\/[A-Za-z0-9_][A-Za-z0-9_-]*(?:\\.[A-Za-z0-9_-]+)*)*$"
    },
    "commits": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^[0-9a-f]{40}$"
      }
    },
    "files": {
      "description": "path to full file content",
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "string"
      }
    },
    "worktreeSubdir": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^(?!\\.\\.?(?:\\/|$))(?!.*\\/\\.\\.?(?:\\/|$))[A-Za-z0-9._-]+(?:\\/[A-Za-z0-9._-]+)*$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "body": {
      "type": "string"
    }
  },
  "if": {
    "properties": {
      "kind": {
        "const": "pr"
      }
    }
  },
  "then": {
    "required": [
      "repo",
      "branch"
    ]
  },
  "oneOf": [
    {
      "properties": {
        "kind": {
          "const": "gist"
        },
        "worktreeSubdir": false
      },
      "required": [
        "files"
      ]
    },
    {
      "properties": {
        "kind": {
          "const": "pr"
        },
        "worktreeSubdir": false
      },
      "required": [
        "repo",
        "branch",
        "files"
      ]
    },
    {
      "properties": {
        "kind": {
          "const": "pr"
        },
        "files": false
      },
      "required": [
        "repo",
        "branch",
        "worktreeSubdir"
      ]
    }
  ]
}
