{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "typed action proposal for the broker",
  "description": "Typed gist reads, owned updates, comments, secret-by-default creation, or PR proposals.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind"
  ],
  "properties": {
    "kind": {
      "enum": [
        "gist",
        "pr",
        "gist_read",
        "gist_update",
        "gist_comment"
      ]
    },
    "repo": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_][A-Za-z0-9_-]*(?:\\.[A-Za-z0-9_-]+)*\\/[A-Za-z0-9_][A-Za-z0-9_-]*(?:\\.[A-Za-z0-9_-]+)*$"
    },
    "branch": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_][A-Za-z0-9_-]*(?:\\.[A-Za-z0-9_-]+)*(?:\\/[A-Za-z0-9_][A-Za-z0-9_-]*(?:\\.[A-Za-z0-9_-]+)*)*$"
    },
    "commits": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^[0-9a-f]{40}$"
      }
    },
    "files": {
      "description": "path to full file content",
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "string"
      }
    },
    "worktreeSubdir": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^(?!\\.\\.?(?:\\/|$))(?!.*\\/\\.\\.?(?:\\/|$))[A-Za-z0-9._-]+(?:\\/[A-Za-z0-9._-]+)*$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "body": {
      "type": "string"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "public": {
      "type": "boolean",
      "description": "Create a public gist only when explicitly true; absent or false creates an unlisted gist."
    }
  },
  "if": {
    "properties": {
      "kind": {
        "const": "pr"
      }
    }
  },
  "then": {
    "required": [
      "repo",
      "branch"
    ]
  },
  "oneOf": [
    {
      "properties": {
        "kind": {
          "const": "gist"
        },
        "worktreeSubdir": false,
        "id": false
      },
      "required": [
        "title",
        "body",
        "files"
      ]
    },
    {
      "properties": {
        "kind": {
          "const": "pr"
        },
        "worktreeSubdir": false,
        "public": false,
        "id": false
      },
      "required": [
        "title",
        "body",
        "repo",
        "branch",
        "files"
      ]
    },
    {
      "properties": {
        "kind": {
          "const": "pr"
        },
        "files": false,
        "public": false,
        "id": false
      },
      "required": [
        "title",
        "body",
        "repo",
        "branch",
        "worktreeSubdir"
      ]
    },
    {
      "properties": {
        "kind": {
          "const": "gist_read"
        },
        "repo": false,
        "branch": false,
        "commits": false,
        "files": false,
        "worktreeSubdir": false,
        "title": false,
        "body": false,
        "public": false
      },
      "required": [
        "id"
      ]
    },
    {
      "properties": {
        "kind": {
          "const": "gist_update"
        },
        "repo": false,
        "branch": false,
        "commits": false,
        "worktreeSubdir": false,
        "body": false,
        "public": false
      },
      "required": [
        "id",
        "files"
      ]
    },
    {
      "properties": {
        "kind": {
          "const": "gist_comment"
        },
        "repo": false,
        "branch": false,
        "commits": false,
        "files": false,
        "worktreeSubdir": false,
        "title": false,
        "public": false,
        "body": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      },
      "required": [
        "id",
        "body"
      ]
    }
  ]
}
