{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "typed action proposal for the broker",
  "description": "A gist needs no repository; a PR needs the repository and the branch it opens from.",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "files", "title", "body"],
  "properties": {
    "kind": { "enum": ["gist", "pr"] },
    "repo": { "type": "string", "minLength": 1 },
    "branch": { "type": "string", "minLength": 1 },
    "files": {
      "description": "path to full file content",
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "type": "string" }
    },
    "title": { "type": "string", "minLength": 1 },
    "body": { "type": "string" }
  },
  "if": { "properties": { "kind": { "const": "pr" } } },
  "then": { "required": ["repo", "branch"] }
}
