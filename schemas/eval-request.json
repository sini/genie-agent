{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "tier-1 request to evaluate one attribute of a repository",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "attr",
    "trusted"
  ],
  "properties": {
    "repo": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9._-]+\\/[A-Za-z0-9._-]+$"
    },
    "rev": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9._-]+$"
    },
    "worktreeSubdir": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9_][A-Za-z0-9._-]*(?:\\/[A-Za-z0-9_][A-Za-z0-9._-]*)*$"
    },
    "attr": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_][A-Za-z0-9_-]*(?:\\.[A-Za-z0-9_][A-Za-z0-9_-]*)*$"
    },
    "trusted": {
      "enum": [
        "yes",
        "no"
      ]
    },
    "secrets": {
      "description": "when a secret blocks eval, 'stub' substitutes agenix/sops paths and placeholder attrs",
      "enum": [
        "stub",
        "none"
      ]
    },
    "apply": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^[^\\u0000]+$"
    }
  },
  "oneOf": [
    {
      "required": [
        "repo",
        "rev"
      ],
      "properties": {
        "worktreeSubdir": false
      }
    },
    {
      "required": [
        "worktreeSubdir"
      ],
      "properties": {
        "repo": false,
        "rev": false
      }
    }
  ]
}
